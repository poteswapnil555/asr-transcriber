# No API keys are needed. All settings are optional.

# Model: base.en (default) or tiny.en (faster, less accurate). Downloaded from Hugging Face on first use.
# ASR_MODEL=base.en
# Folder for the downloaded model files (default: the Hugging Face cache)
# ASR_MODEL_DIR=models
# Set to 1 to forbid any download (fail with a clear message if the model is not already on disk)
# ASR_OFFLINE=0

# Limits
# MAX_AUDIO_MINUTES=30
# SILENCE_DBFS=-50
